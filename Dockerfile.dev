# Development image only. The Cloudflare Worker build is produced by vinext/wrangler,
# not by this Dockerfile.
FROM node:22-bookworm-slim

# better-sqlite3 falls back to a source build when no prebuilt binary matches.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=development
WORKDIR /app

# node_modules and .next live in named volumes so the Linux-native better-sqlite3
# build is never shadowed by the host's macOS/Windows build.
RUN mkdir -p /app/node_modules /app/.next /app/data

EXPOSE 3000
CMD ["npm", "run", "dev"]
