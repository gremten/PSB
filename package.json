{
  "name": "psb-usability-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:cloudflare": "npm run db:migrate:remote && npm run deploy:vinext",
    "db:migrate:local": "wrangler d1 migrations apply PSB_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply PSB_DB --remote"
  },
  "dependencies": {
    "@fontsource-variable/onest": "latest",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "better-sqlite3": "^13.0.3",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "typescript": "latest",
    "vite": "^8.2.2",
    "vitest": "latest",
    "wrangler": "^4.130.0"
  },
  "type": "module"
}
